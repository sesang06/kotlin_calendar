root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 140
# Compose의 @Composable 함수는 PascalCase를 쓴다.
ktlint_function_naming_ignore_when_annotated_with = Composable
# 테스트 이름은 백틱 한글 문장을 허용한다 (server-testing 스킬).
ktlint_standard_function-naming = enabled

[*.{yml,yaml,proto,toml}]
indent_size = 2

[*.bat]
end_of_line = crlf
